# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Every variable the API reads is listed here. Settings that are commented out have a default.

# --- Database ----------------------------------------------------------------------------
# Two database roles. The OWNER, rag_lab, creates the database and owns its tables; only
# `npm run migrate` and the tests' own setup connect as it. The API connects as rag_lab_api,
# which reads and changes rows and nothing else; the server refuses to start if its URL
# connects as a role with more rights. rag_lab_api is created once with
# scripts/create-api-role.sql, and its password is set with \password rag_lab_api (see the
# README); use a different password from the owner's.

# The owner's password (letters and digits only, so it works inside the URLs): used by the
# compose file to create the database user rag_lab, and by the owner URLs below.
POSTGRES_PASSWORD=change-me

# The API's connection to the development database, as rag_lab_api. The compose project
# publishes PostgreSQL on 127.0.0.1:25432. The names (rag_lab, port 25432) differ from RAG
# Web's on purpose: a URL copied from RAG Web fails loudly instead of reaching the wrong
# database. Required by the server and by `npm run create-admin`; not used by `npm run migrate`.
DATABASE_URL=postgresql://rag_lab_api:change-me-api@127.0.0.1:25432/rag_lab

# The owner's connection to the development database, used only by `npm run migrate`, which
# changes the schema. It is never a fallback for DATABASE_URL, and the other way round.
MIGRATION_DATABASE_URL=postgresql://rag_lab:change-me@127.0.0.1:25432/rag_lab

# The test database, as both roles. The tests EMPTY it on every run, and its name must end
# in _test. Create it once: docker compose exec db createdb -U rag_lab rag_lab_test
# Also set both as Windows user environment variables: a worktree has no .env of its own.
# test/setup.ts copies the first into DATABASE_URL (the app runs as the API role, as in
# production) and the second into MIGRATION_DATABASE_URL (the tests' schema work and the
# migration script run as the owner). A missing one is removed from its target, so the
# tests can never reach the development database.
RAG_LAB_TEST_API_DATABASE_URL=postgresql://rag_lab_api:change-me-api@127.0.0.1:25432/rag_lab_test
RAG_LAB_TEST_DATABASE_URL=postgresql://rag_lab:change-me@127.0.0.1:25432/rag_lab_test

# Optional, tests only: the address of a real Ollama (with qwen3-embedding:0.6b installed), for the
# live embedding test in test/integration/. Without it that test is skipped, and no test calls a
# real model. The API does not read it.
# RAG_LAB_LIVE_OLLAMA_URL=http://localhost:11434

# --- Authentication ----------------------------------------------------------------------
# Signs the login tokens. At least 32 characters; the API refuses to start with a shorter
# value or with this placeholder. Replace it with a random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The tests use this exact placeholder (test/config/placeholder.ts), so do not change it here.
SECRET_KEY=change-me-to-a-long-random-value-0000

# --- Optional settings (the defaults are shown; uncomment a line to change it) -------------
# Integers are plain decimal digits only ("3600", not "1e3" or "0x10"). A value out of range
# stops the API at startup; it is never shortened to fit.

# Address and port the API listens on. HOST 127.0.0.1 keeps it reachable from this computer
# only; inside Docker it must be 0.0.0.0. PORT: 1 to 65535.
# HOST=127.0.0.1
# PORT=3000

# Comma-separated proxies trusted to report the client's address in X-Forwarded-For
# (cloudflared in production). Never "true".
# TRUSTED_PROXIES=loopback

# Comma-separated browser origins allowed to call the API. Empty: any origin (development).
# CORS_ORIGINS=https://app.example.com

# Where Ollama listens: an absolute http or https URL (a trailing slash is dropped).
# Use http://host.docker.internal:11434 once the API runs in Docker.
# OLLAMA_BASE_URL=http://localhost:11434

# How long one request to Ollama may take, in milliseconds (an embedding batch while indexing
# a document, or the embedding of a question, which also stops at MAX_QUESTION_SECONDS):
# 1000 to 600000.
# OLLAMA_TIMEOUT_MS=120000

# How long a login token stays valid, in seconds: 1 to 86400.
# TOKEN_LIFETIME_SECONDS=3600

# Requests per minute one logged-in user may make to the protected routes: at least 1.
# AUTHENTICATED_REQUESTS_PER_MINUTE=120

# Requests per minute one client address may make in total, to any path, public or not and
# forged tokens included. It runs before everything else, so an address that floods the API
# is answered with a 429 before its token is checked: at least 1. Several users behind one
# address share it.
# REQUESTS_PER_ADDRESS_PER_MINUTE=300

# Logins per client address per 15 minutes, successful ones included: at least 1.
# LOGINS_PER_15_MINUTES=10

# Failed logins per email and client address per 15 minutes: at least 1.
# FAILED_LOGINS_PER_EMAIL_PER_15_MINUTES=5

# Password change attempts per user per 15 minutes, wrong ones included: at least 1.
# PASSWORD_CHANGES_PER_15_MINUTES=5

# Accounts one admin may create per hour, every attempt counted: at least 1.
# USER_CREATIONS_PER_HOUR=20

# Profiles (saved configurations) one user may keep: 1 to 1000. Each one is a row the user
# can fill with settings, so the number is capped at both ends. A creation over the limit
# is answered with a 409. The caps on the values of the settings are not here: they are in
# the code (src/v1/config/configuration.config.ts) and change only with a new version.
# MAX_PROFILES_PER_USER=20

# Documents one user may keep: 1 to 1000. An upload over the limit is answered with a 409.
# MAX_DOCUMENTS_PER_USER=3

# Largest document text, in characters (UTF-16 units, counted before cleaning): 1 to 5000000.
# The upload body limit follows from it (3 bytes per character plus 16 kB), so a higher value
# also lets the API read larger bodies into memory.
# MAX_DOCUMENT_CHARACTERS=1000000

# Upload requests per minute one user may make, counted before the body is read: 1 to 1000.
# UPLOAD_REQUESTS_PER_MINUTE=5

# Index builds one user may have queued or running at once: 1 to 100 (409 over it).
# MAX_ACTIVE_INDEX_BUILDS_PER_USER=1

# Index builds waiting in the queue, all users together (builds already running are not
# counted): 1 to 1000 (503 over it).
# MAX_QUEUED_INDEX_BUILDS=20

# Index builds one user may start in the last 24 hours, uploads included; deleting a
# document or an index does not give a build back: 1 to 1000 (429 over it). The default is
# the number of allowed chunk sizes, so one document can be indexed at every size each day.
# MAX_INDEX_BUILDS_PER_DAY=6

# Index builds all users together may start in the last 24 hours: 1 to 10000 (429 over it).
# It bounds the GPU time spent on indexing however many accounts exist.
# MAX_INDEX_BUILDS_PER_DAY_TOTAL=100

# Searches per minute one user may make, counted before the body is read: 1 to 1000 (429).
# QUESTIONS_PER_MINUTE=10

# Questions one user may send to the model in the last 24 hours: 1 to 100000 (429 over it).
# They are counted in the question_usage table, one row for every question whose embedding
# was done. A client that hangs up while the embedding runs still counts, and so does a
# question whose run was not stored afterwards, because the model did the work; a failure of
# the model server (503, 504, a malformed answer) and a hang-up while waiting for the model's
# turn do not count.
# MAX_QUESTIONS_PER_DAY=30

# Seconds one search may take, waiting for the model's turn included: 1 to 90 (Cloudflare
# cuts a response at 100 s). A search that runs out of time is a 503 while it waits for the
# turn and a 504 once the model has been asked. One question at a time per user is fixed in
# the code, not a setting.
# MAX_QUESTION_SECONDS=60

# Searches waiting for the model, all users together: 1 to 1000 (503 over it). Index builds
# are not counted here; they have their own cap.
# MAX_WAITING_QUESTIONS=20

# Health checks per minute one client address may make (the endpoint is public): at least 1.
# HEALTH_CHECKS_PER_MINUTE=30

# Seconds a health report is reused before the database and Ollama are checked again:
# 0 (check every time) to 300.
# HEALTH_CACHE_SECONDS=10

# --- Agent hooks (.claude/hooks/agent-scope.mjs) ----------------------------------------
# These can also be set as user environment variables, which is what worktrees need: a new
# worktree has no .env of its own.

# Private data folder outside the repository: evaluation sets, documents, run results.
# Readable by experiment-runner, lab-reporter and analyst only.
RAG_LAB_DATA_DIR=D:\path\to\RAG Lab Data

# RAG Web checkout, read by planner, test-writer, implementer and docs-keeper for porting.
# Only its src/, test/, migrations/, scripts/, docs/, .claude/skills|agents|hooks/ and root
# config files are readable; its .env and RAG1's private data are not.
RAG_WEB_DIR=D:\path\to\RAG Web

# --- Evaluation harness (npm run eval:retrieval) -----------------------------------------
# The API does not read these. The harness signs in as an ordinary user account made for it
# (created with the admin endpoint); its password lives only here and is never printed. Plain
# http is allowed only for a loopback address. The harness also reads OLLAMA_BASE_URL above,
# for the model digests it records: that address is the harness's own and is not compared with
# the API's, so point both at the same Ollama. --check needs neither the account nor the API.
# RAG_LAB_EVAL_API_URL=http://127.0.0.1:3000
RAG_LAB_EVAL_EMAIL=harness@example.com
RAG_LAB_EVAL_PASSWORD=change-me-to-the-harness-password
