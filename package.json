{
    "name": "rag-lab-api",
    "version": "0.1.0",
    "description": "RAG API built by a team of Claude Code agents: two local models with a router, measured per question.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "tsx src/migrate.ts",
        "create-admin": "tsx src/createAdmin.ts",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
        "test:file": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.5",
        "joi": "^18.3.2",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.20.7",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
